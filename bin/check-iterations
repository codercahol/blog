#!/usr/bin/env python3
"""Check built pages, version navigation, and snapshot link isolation."""
from html.parser import HTMLParser
from pathlib import Path
from urllib.parse import unquote, urlsplit


class Page(HTMLParser):
    def __init__(self):
        super().__init__()
        self.in_switcher = False
        self.switchers = 0
        self.selected = []
        self.links = []

    def handle_starttag(self, tag, attrs):
        attrs = dict(attrs)
        if tag == "nav" and attrs.get("aria-label") == "Website iterations":
            self.in_switcher = True
            self.switchers += 1
        if self.in_switcher and tag == "a" and attrs.get("aria-current") == "page":
            self.selected.append(attrs.get("href"))
        for attr in ("href", "src", "data"):
            if attrs.get(attr):
                self.links.append((attrs[attr], self.in_switcher))

    def handle_endtag(self, tag):
        if tag == "nav":
            self.in_switcher = False


root = Path(__file__).resolve().parent.parent / "_site"
versions = {path.name for path in root.iterdir() if path.is_dir() and path.name.isdigit()}
assert {"2", "3"} <= versions, "Missing retained iterations"
assert "1" not in versions, "Removed iteration 1 is still being published"
assert (root / "2/about/index.html").is_file(), "Missing /2/about/"
assert "<h1" in (root / "2/about/index.html").read_text()
checked = 0
for file in root.rglob("*.html"):
    page = Page()
    page.feed(file.read_text())
    assert page.switchers == 1, f"{file}: expected one version switcher"
    assert len(page.selected) == 1, f"{file}: expected one current iteration"
    version = file.relative_to(root).parts[0]
    for url, in_switcher in page.links:
        parsed = urlsplit(url)
        if parsed.scheme or parsed.netloc or not parsed.path:
            continue
        target = root / unquote(parsed.path.lstrip("/")) if parsed.path.startswith("/") else file.parent / unquote(parsed.path)
        assert target.is_file() or (target / "index.html").is_file(), f"{file}: broken link {url}"
        if version in versions and not in_switcher and parsed.path.startswith("/"):
            assert parsed.path.startswith(f"/{version}/") or parsed.path == "/assets/css/iterations.css", f"{file}: link leaves iteration: {url}"
    checked += 1
print(f"Verified {checked} pages: version navigation, nested routes, and local links.")
