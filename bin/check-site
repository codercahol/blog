#!/usr/bin/env python3
"""Verify the publishing build's local links and excluded review content."""
from html.parser import HTMLParser
from pathlib import Path
from urllib.parse import unquote, urlsplit


class Page(HTMLParser):
    def __init__(self):
        super().__init__()
        self.links = []

    def handle_starttag(self, tag, attrs):
        attrs = dict(attrs)
        assert attrs.get("aria-label") != "Website iterations", "Review navigation in publishing build"
        for attr in ("href", "src", "data"):
            if attrs.get(attr):
                self.links.append(attrs[attr])


root = Path(__file__).resolve().parent.parent / "_site"
assert not any(path.is_dir() and path.name.isdigit() for path in root.iterdir()), "Numbered snapshots in publishing build"
assert not (root / "_reference").exists(), "Private reference archive in publishing build"
assert not (root / "codex_instructions").exists(), "Local instructions in publishing build"
assert {file.relative_to(root).as_posix() for file in root.rglob("*.html")} == {"index.html", "BiTSconceptnote/index.html", "404.html"}, "Unexpected extra pages"
checked = 0
for file in root.rglob("*.html"):
    page = Page()
    page.feed(file.read_text())
    for url in page.links:
        parsed = urlsplit(url)
        if parsed.scheme or parsed.netloc or not parsed.path:
            continue
        target = root / unquote(parsed.path.lstrip("/")) if parsed.path.startswith("/") else file.parent / unquote(parsed.path)
        assert target.is_file() or (target / "index.html").is_file(), f"{file}: broken link {url}"
    checked += 1
print(f"Verified {checked} pages: local links and publishing exclusions.")
