#!/usr/bin/env sh
set -eu

BUNDLER_VERSION="2.3.27"
BUNDLE_USER_HOME="${BUNDLE_USER_HOME:-$PWD/.bundle}"
export BUNDLE_USER_HOME
USER_BUNDLE="$(ruby -e 'require "rubygems"; print File.join(Gem.user_dir, "bin", "bundle")')"

if ! command -v bundle >/dev/null 2>&1 && [ ! -x "$USER_BUNDLE" ]; then
  gem install --user-install "bundler:${BUNDLER_VERSION}"
fi

if command -v bundle >/dev/null 2>&1; then
  BUNDLE_BIN="bundle"
else
  BUNDLE_BIN="$USER_BUNDLE"
fi

BUNDLE_PATH="${BUNDLE_PATH:-vendor/bundle}" exec "$BUNDLE_BIN" "_${BUNDLER_VERSION}_" install
