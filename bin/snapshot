#!/usr/bin/env python3
"""Freeze an already-built Jekyll site at a new numeric URL prefix."""
import argparse
from pathlib import Path
import re
import shutil
from urllib.parse import urlsplit


parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("number", type=int)
parser.add_argument("--source", type=Path, default=Path("_site"))
args = parser.parse_args()
root = Path(__file__).resolve().parent.parent
source = args.source.resolve()
destination = root / str(args.number)
if args.number < 1 or destination.exists():
    parser.error("Choose a positive, unused iteration number; snapshots are never overwritten.")
if not (source / "index.html").is_file():
    parser.error("Source must be a built site containing index.html.")


def prefix_url(value):
    parsed = urlsplit(value)
    if parsed.netloc in {"leronperez.com", "www.leronperez.com"}:
        value = parsed.path or "/"
        if parsed.query:
            value += "?" + parsed.query
        if parsed.fragment:
            value += "#" + parsed.fragment
    if value.startswith("/") and not value.startswith("//"):
        return f"/{args.number}{value}"
    return value


destination.mkdir()
for file in source.rglob("*"):
    relative = file.relative_to(source)
    if not file.is_file() or relative.parts[0].isdigit():
        continue
    if any(part.startswith(".") for part in relative.parts):
        continue
    if relative.name in {"CNAME", "sitemap.xml", "robots.txt"}:
        continue
    target = destination / relative
    target.parent.mkdir(parents=True, exist_ok=True)
    if file.suffix in {".html", ".css", ".js", ".xml", ".svg"}:
        content = file.read_text()
        content = content.replace('href="doi.org/', 'href="https://doi.org/')
        content = re.sub(r"<!-- iterations:start -->.*?<!-- iterations:end -->\s*", "", content, flags=re.S)
        content = re.sub(r'<link rel="stylesheet" href="[^"]*/assets/css/iterations\.css">\s*', "", content)
        # Handles HTML attributes, CSS strings, and same-origin absolute URLs.
        content = re.sub(r'''(["'])(/[^\s"'<>]*|https?://(?:www\.)?leronperez\.com(?:/[^\s"'<>]*)?)\1''',
                         lambda match: match[1] + prefix_url(match[2]) + match[1], content)
        content = re.sub(r"url\(\s*(/[^)\s]+)\s*\)",
                         lambda match: "url(" + prefix_url(match[1]) + ")", content)
        # Redirect meta tags may contain a root URL inside a longer value.
        content = re.sub(r'(?i)(url=)(/[^\s"<>]*)',
                         lambda match: match[1] + prefix_url(match[2]), content)
        if file.suffix == ".html":
            content = content.replace("</head>", '<meta name="robots" content="noindex, follow">\n</head>')
        target.write_text(content)
    else:
        shutil.copyfile(file, target)
print(f"Saved iteration {args.number} at {destination}")
